# Copy this file to .env and fill in your own values.

# Main chat model: gemini or mistral. The other one is used
# automatically as a backup (e.g. when the Gemini daily quota runs out).
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
MISTRAL_MODEL=mistral-small-latest

GOOGLE_API_KEY=
MISTRAL_API_KEY=
TAVILY_API_KEY=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=researchflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=researchflow_documents

# LLM settings (see backend/llm.py and backend/agent/routing.py)
LLM_PROVIDER=gemini            # or "mistral" while the Gemini quota is used up
GEMINI_MODEL=gemini-3.6-flash
MISTRAL_MODEL=mistral-small-latest
LLM_CACHE=on                   # "off" to always call the model
PLANNER_MODE=auto              # auto | always | never
DOC_RELEVANCE_THRESHOLD=0      # higher = use web search more often
