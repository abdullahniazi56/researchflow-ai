# Copy this file to .env and fill in your own values.
# Comments must be on their own line (not after a value).

# ---------- LLM ----------
# Main model: "gemini" or "mistral". The other one is used automatically
# as a fallback when its API key is set.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
MISTRAL_MODEL=mistral-small-latest
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# Cache identical LLM requests on disk ("off" to disable)
LLM_CACHE=on

# ---------- Research agent ----------
# "rules" = rule-based tool choice (cheap, default)
# "llm"   = the LLM chooses tools through tool calling
ROUTING_MODE=rules
# Split questions into sub-questions: auto | always | never
PLANNER_MODE=auto
# Reranker score below which PDF results count as weak (then web search runs)
DOC_RELEVANCE_THRESHOLD=0
# Reranker score a cited claim needs to count as supported
CITATION_SUPPORT_THRESHOLD=0
# Candidates fetched from Qdrant before reranking
RETRIEVAL_CANDIDATES=10

# ---------- Web search ----------
TAVILY_API_KEY=

# ---------- Postgres ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=researchflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=researchflow_documents

# ---------- Production (docker-compose.prod.yml) ----------
# Public domain name, e.g. researchflow.duckdns.org (see DEPLOY.md)
DOMAIN=

# ---------- API ----------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: require the header X-API-Key on every request
API_KEY=
LOG_LEVEL=INFO
