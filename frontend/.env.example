# Copy to frontend/.env only if you need to change the defaults.
#
# Development: leave VITE_API_URL empty. The app calls /api and the
# Vite dev server forwards it to http://127.0.0.1:8000 (see vite.config.js).
# Production build: set it to the deployed backend URL.
VITE_API_URL=
# Only needed when the backend has API_KEY set
VITE_API_KEY=
